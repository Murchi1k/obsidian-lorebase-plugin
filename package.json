{
    "name": "lorebase",
    "version": "4.0.1",
    "description": "A media hub for games, anime, movies, series, books, manga, and music with rich cards, progress, ratings, and metadata.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "games",
        "anime",
        "movies",
        "books",
        "library"
    ],
    "author": "Murch1k",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.43",
        "esbuild": "^0.28.2",
        "happy-dom": "^21.0.4",
        "obsidian": "^1.14.4",
        "tslib": "^2.9.1",
        "typescript": "^5.3.2",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "fflate": "0.8.3",
        "hls.js": "1.7.4"
    }
}
